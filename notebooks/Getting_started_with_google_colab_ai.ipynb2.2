        "### 4. Cleaning 'Year' Column\n",
        "\n",
        "Ensure the 'Year' column is of numeric type. Missing values will be filled with the mode (most frequent year)."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 413
        },
        "id": "c305e3ba",
        "outputId": "91d4148a-a092-492e-b384-409d7610f63d"
      },
      "source": [
        "if 'production_year' in df.columns:\n",
        "    df['production_year'] = pd.to_numeric(df['production_year'], errors='coerce')\n",
        "\n",
        "    # Fill missing years with the mode\n",
        "    mode_year = df['production_year'].mode()[0]\n",
        "    df['production_year'] = df['production_year'].fillna(mode_year)\n",
        "    df['production_year'] = df['production_year'].astype(int) # Convert to integer after filling\n",
        "    print(f\"'production_year' column cleaned. Missing values filled with mode: {mode_year}.\")\n",
        "elif 'BuraxД±lД±Еџ ili' in df.columns: # Assuming 'BuraxД±lД±Еџ ili' might be year in Azeri\n",
        "    df['BuraxД±lД±Еџ ili'] = pd.to_numeric(df['BuraxД±lД±Еџ ili'], errors='coerce')\n",
        "    mode_year = df['BuraxД±lД±Еџ ili'].mode()[0]\n",
        "    df['BuraxД±lД±Еџ ili'] = df['BuraxД±lД±Еџ ili'].fillna(mode_year)\n",
        "    df['BuraxД±lД±Еџ ili'] = df['BuraxД±lД±Еџ ili'].astype(int)\n",
        "    print(f\"'BuraxД±lД±Еџ ili' column (Year) cleaned. Missing values filled with mode: {mode_year}.\")\n",
        "else:\n",
        "    print(\"Neither 'production_year' nor 'BuraxД±lД±Еџ ili' column found. Skipping year cleaning.\")\n",
        "\n",
        "display(df.filter(like='year', axis=1).head())\n",
        "display(df.filter(like='BuraxД±lД±Еџ ili', axis=1).head())"
      ],
