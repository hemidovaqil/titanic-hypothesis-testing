        "### 3. Cleaning 'Engine_Volume' Column\n",
        "\n",
        "We will extract the numerical part from the 'Engine_Volume' column (e.g., '2.0 L' becomes 2.0) and convert it to a numeric type. Missing values will be filled with the median."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 395
        },
        "id": "0ccebb45",
        "outputId": "95d0e545-6f6d-40fe-a550-4e72f7af30aa"
      },
      "source": [
        "if 'engine_displacement_num' in df.columns:\n",
        "    # Extract numerical part and convert to numeric\n",
        "    df['engine_displacement_num'] = df['engine_displacement_num'].astype(str).str.extract('([0-9.]+)', expand=False)\n",
        "    df['engine_displacement_num'] = pd.to_numeric(df['engine_displacement_num'], errors='coerce')\n",
        "\n",
        "    # Fill missing engine volume with the median\n",
        "    median_engine_volume = df['engine_displacement_num'].median()\n",
        "    df['engine_displacement_num'] = df['engine_displacement_num'].fillna(median_engine_volume)\n",
        "    print(f\"'engine_displacement_num' column cleaned. Missing values filled with median: {median_engine_volume}.\")\n",
        "elif 'MГјhЙ™rrik hЙ™cmi' in df.columns: # 'MГјhЙ™rrik hЙ™cmi' is engine volume in Azeri\n",
        "    df['MГјhЙ™rrik hЙ™cmi'] = df['MГјhЙ™rrik hЙ™cmi'].astype(str).str.extract('([0-9.]+)', expand=False)\n",
        "    df['MГјhЙ™rrik hЙ™cmi'] = pd.to_numeric(df['MГјhЙ™rrik hЙ™cmi'], errors='coerce')\n",
        "    median_engine_volume = df['MГјhЙ™rrik hЙ™cmi'].median()\n",
        "    df['MГјhЙ™rrik hЙ™cmi'] = df['MГјhЙ™rrik hЙ™cmi'].fillna(median_engine_volume)\n",
        "    print(f\"'MГјhЙ™rrik hЙ™cmi' column (Engine Volume) cleaned. Missing values filled with median: {median_engine_volume}.\")\n",
        "else:\n",
        "    print(\"Neither 'engine_displacement_num' nor 'MГјhЙ™rrik hЙ™cmi' column found. Skipping engine volume cleaning.\")\n",
        "\n",
