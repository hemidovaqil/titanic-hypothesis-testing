      },
      "source": [
        "categorical_cols = ['Fuel_Type', 'Transmission', 'Color', 'Body_Type', 'Brand', 'Model', 'Ban_Type', 'Gear_Box', 'SГјrЙ™tlЙ™r qutusu', 'Yanacaq nГ¶vГј', 'Г–tГјrГјcГј', 'Marka', 'Ban nГ¶vГј'] # Added 'Marka' and 'Ban nГ¶vГј'\n",
        "\n",
        "for col in categorical_cols:\n",
        "    if col in df.columns:\n",
        "        df[col] = df[col].astype(str).str.lower().str.strip()\n",
        "        df[col] = df[col].fillna('unknown') # Fixed FutureWarning\n",
        "        print(f\"'{col}' column cleaned. Missing values filled with 'unknown'.\")\n",
        "        # Optional: Print unique values to check standardization\n",
        "        # print(f\"Unique values for {col}: {df[col].unique()[:10]}\")\n",
        "    else:\n",
        "        # print(f\"'{col}' column not found. Skipping categorical cleaning for this column.\")\n",
        "        pass\n",
        "\n",
        "print(\"\\nFirst 5 rows of cleaned categorical columns:\")\n",
        "display(df[df.columns.intersection(categorical_cols)].head())"
